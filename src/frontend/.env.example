# Optional — shard count shown client-side (e.g. QueryWorkspace's shard-routing hint).
# Must match how many SHARD_*_URL vars the backend has configured.
VITE_SHARD_COUNT=3

# Optional — backend origin, e.g. https://api.example.com. Leave unset when the
# frontend is served same-origin with the backend (dev proxy or reverse proxy).
VITE_API_BASE_URL=

# Must match the backend's API_KEY.
VITE_API_KEY=
