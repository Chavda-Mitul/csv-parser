# Overrides for running the app under `docker compose up`.
# The shard hosts here are the compose service names, not localhost — containers
# reach each other by service name on the compose network. Copy to `.env.docker`
# (gitignored) and adjust if you rename the shard services/ports.
SHARD_1_URL=postgresql://postgres:postgrespassword@postgres_shard_1:5432/shard_1
SHARD_2_URL=postgresql://postgres:postgrespassword@postgres_shard_2:5432/shard_2
SHARD_3_URL=postgresql://postgres:postgrespassword@postgres_shard_3:5432/shard_3
