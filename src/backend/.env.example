# Required
PORT=3000
GCS_BUCKET_NAME=your-gcs-bucket-name
SHARD_1_URL=postgresql://postgres:postgres@localhost:5432/shard_1
SHARD_2_URL=postgresql://postgres:postgres@localhost:5433/shard_2
SHARD_3_URL=postgresql://postgres:postgres@localhost:5434/shard_3
PGBOSS_URL=postgresql://postgres:postgres@localhost:5435/jobs

# Optional — only needed if ADC can't infer the GCP project
GCP_PROJECT_ID=your-gcp-project-id

# Optional — restricts CORS to this origin (e.g. https://app.example.com).
# Needed when the frontend is deployed separately from the backend. Unset = allow all.
FRONTEND_ORIGIN=
